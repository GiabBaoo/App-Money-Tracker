<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- 1. Header: Tiêu đề ví / Ứng dụng + Nút ẩn hiện số dư -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● "
                android:textColor="@color/widget_text_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số dư"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_eye"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_eye_visible"
            android:contentDescription="Ẩn hiện số dư"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 2. Phần giữa: Số dư nổi bật (Hero Metric) + Badge trạng thái -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_total_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0đ"
            android:textColor="@color/widget_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_safe"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widget_safe_spend_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hôm nay còn 0đ"
                android:textColor="@color/widget_btn_income_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Thao tác nhanh công thái học: 2 Nút lớn Chi / Thu nhiều màu sắc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <!-- Nút Thêm Chi Tiêu (Đỏ San Hô) -->
        <LinearLayout
            android:id="@+id/widget_btn_expense"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_expense"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="− Chi tiền"
                android:textColor="@color/widget_btn_expense_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Thêm Khoản Thu (Xanh Ngọc) -->
        <LinearLayout
            android:id="@+id/widget_btn_income"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_income"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Thu tiền"
                android:textColor="@color/widget_btn_income_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Quét bill ẩn để giữ tương thích Kotlin -->
        <LinearLayout
            android:id="@+id/widget_btn_scan"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Biểu đồ cột ẩn để giữ tương thích Kotlin và làm widget thoáng đãng -->
        <ImageView
            android:id="@+id/widget_bar_chart"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="Biểu đồ 7 ngày" />
    </LinearLayout>

</LinearLayout>
