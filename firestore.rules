rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════ HELPERS CHUNG ════════
    function signedIn()    { return request.auth != null; }
    function uid()         { return request.auth.uid; }
    function incoming()    { return request.resource.data; }
    function existing()    { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ════════ DỮ LIỆU CÁ NHÂN (uid-scoped) ════════
    function ownsExisting()  { return signedIn() && existing().uid == uid(); }
    function createsOwn()    { return signedIn() && incoming().uid is string && incoming().uid == uid(); }
    function updatesOwn()    { return ownsExisting() && incoming().uid == existing().uid; } // uid bất biến
    function deletesOwn()    { return signedIn() && (resource == null || existing().uid == uid()); }

    match /transactions/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /wallets/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /budgets/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /goals/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /messages/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /device_sessions/{docId} {
      allow read:   if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
      allow delete: if deletesOwn();
    }
    match /biometric_prefs/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ════════ HỒ SƠ NGƯỜI DÙNG — khóa bất biến & bảo vệ subcollections ════════
    function keepsValue(field, defaultVal) {
      return request.resource.data.get(field, defaultVal) == resource.data.get(field, defaultVal);
    }
    match /users/{userId} {
      allow read:   if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
                    && incoming().get('uid', userId) == userId
                    && incoming().get('role', 'user') == 'user'
                    && incoming().get('accountType', 'FREE') == 'FREE';
      allow update: if signedIn() && uid() == userId
                    && incoming().get('uid', userId) == userId
                    && keepsValue('role', 'user')
                    && keepsValue('accountType', 'FREE')
                    && (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
                    && (!('email' in incoming()) || incoming().email == existing().email);
      allow delete: if signedIn() && uid() == userId;

      // Subcollections của users (tokens, settings, device_tokens...)
      match /{subcollection=**} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Hồ sơ công khai tối thiểu cho tính năng nhóm (tên/avatar thành viên)
    match /public_profiles/{userId} {
      allow read:   if signedIn();
      allow create, update: if signedIn() && uid() == userId
                    && incoming().keys().hasOnly(['name', 'username', 'avatarUrl', 'updatedAt']);
      allow delete: if signedIn() && uid() == userId;
    }
    // Tra cứu theo SĐT khi mời: chỉ get đúng 1 doc, cấm list (chống dò hàng loạt).
    match /phone_index/{phoneE164} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn() && incoming().uid == uid() && incoming().keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if signedIn() && existing().uid == uid();
    }

    // ════════ HELPERS NHÓM ════════
    function groupPath(groupId)  { return /databases/$(database)/documents/groups/$(groupId); }
    function groupExists(groupId){ return groupId is string && exists(groupPath(groupId)); }
    function groupOf(groupId)    { return get(groupPath(groupId)).data; }
    function isMemberOf(groupId) {
      return signedIn() && groupExists(groupId)
        && uid() in groupOf(groupId).memberIds
        && groupOf(groupId).get('isDeleted', false) != true;
    }
    function isAdminOfGroup(groupId) {
      return signedIn() && groupExists(groupId) && (
        groupOf(groupId).get('adminId', '') == uid() ||
        groupOf(groupId).get('ownerId', '') == uid()
      );
    }
    function allInGroup(groupId, ids) {
      return ids is list && ids.toSet().difference(groupOf(groupId).memberIds.toSet()).size() == 0;
    }
    function invitePath(groupId, inviteeUid) {
      return /databases/$(database)/documents/group_invites/$(groupId + '_' + inviteeUid);
    }

    // ════════ NHÓM ════════
    match /groups/{groupId} {
      function g()        { return resource.data; }
      function ng()       { return request.resource.data; }
      function added()    { return ng().memberIds.toSet().difference(g().memberIds.toSet()); }
      function removed()  { return g().memberIds.toSet().difference(ng().memberIds.toSet()); }
      function isAdminHere()  {
        return signedIn() && (
          g().get('adminId', '') == uid() ||
          g().get('ownerId', '') == uid()
        );
      }
      function isMemberHere() { return signedIn() && uid() in g().memberIds; }

      // (a) Admin sửa metadata / xóa thành viên — KHÔNG thêm, KHÔNG đổi adminId
      function adminEditsGroup() {
        return isAdminHere()
          && changedKeys().hasOnly(['name', 'description', 'iconUrl', 'iconCode', 'groupType',
                                    'currency', 'memberIds', 'updatedAt', 'isDeleted', 'deletedAt'])
          && added().size() == 0
          && (ng().get('adminId', '') in ng().memberIds || ng().get('ownerId', '') in ng().memberIds);
      }
      // (b) Admin chuyển quyền cho thành viên sẵn có
      function adminTransfersOwnership() {
        return isAdminHere()
          && (changedKeys().hasOnly(['adminId', 'updatedAt']) || changedKeys().hasOnly(['adminId', 'ownerId', 'updatedAt']))
          && (ng().get('adminId', '') in g().memberIds);
      }
      // (c) Thành viên (không phải admin) tự rời — chỉ xóa đúng mình
      function memberLeaves() {
        return isMemberHere() && !isAdminHere()
          && changedKeys().hasOnly(['memberIds', 'updatedAt'])
          && added().size() == 0
          && removed() == [uid()].toSet();
      }
      // (d) Người được mời tự gia nhập — chỉ thêm đúng mình, lời mời bị tiêu thụ nguyên tử
      function inviteeJoins() {
        let inv = invitePath(groupId, uid());
        return !isMemberHere()
          && g().get('isDeleted', false) != true
          && changedKeys().hasOnly(['memberIds', 'updatedAt'])
          && removed().size() == 0
          && added() == [uid()].toSet()
          && exists(inv)
          && get(inv).data.status == 'pending'
          && get(inv).data.expiresAt > request.time
          && getAfter(inv).data.status == 'accepted';
      }

      allow read: if isMemberHere() || isAdminHere();
      allow create: if signedIn()
        && ng().get('id', groupId) == groupId
        && (ng().get('adminId', '') == uid() || ng().get('ownerId', '') == uid())
        && ng().memberIds == [uid()]                       // thành viên khác vào qua lời mời
        && ng().get('isDeleted', false) == false
        && !ng().keys().hasAny(['role', 'roles', 'memberRoles']);
      allow update: if signedIn()
        && ng().memberIds is list
        && ng().get('id', groupId) == g().get('id', groupId)
        && (!('createdAt' in ng()) || ng().createdAt == g().createdAt)
        && (!('ownerId' in ng()) || ng().ownerId == g().ownerId)
        && !changedKeys().hasAny(['id', 'createdAt', 'role', 'roles', 'memberRoles'])
        && (adminEditsGroup() || adminTransfersOwnership() || memberLeaves() || inviteeJoins());
      allow delete: if false;                              // chỉ soft-delete (isDeleted)

      // Phân quyền cho Subcollections của nhóm (members, expenses, settlements, funds...)
      match /{subcollection=**} {
        allow read: if isMemberHere() || isAdminHere();
        allow write: if isMemberHere() || isAdminHere();
      }
    }

    // ════════ LỜI MỜI (doc id = "{groupId}_{inviteeUid}") ════════
    match /group_invites/{inviteId} {
      allow read: if signedIn()
        && (existing().inviteeUid == uid() || isAdminOfGroup(existing().groupId));

      allow create: if signedIn()
        && inviteId == incoming().groupId + '_' + incoming().inviteeUid
        && incoming().keys().hasOnly(['groupId', 'groupName', 'inviteeUid', 'invitedBy',
                                      'status', 'createdAt', 'expiresAt'])
        && incoming().invitedBy == uid()
        && isAdminOfGroup(incoming().groupId)
        && incoming().inviteeUid is string
        && incoming().inviteeUid != uid()
        && !(incoming().inviteeUid in groupOf(incoming().groupId).memberIds)
        && incoming().status == 'pending'
        && incoming().expiresAt is timestamp
        && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(7, 'd');

      allow update: if signedIn() && (
        // Người được mời chấp nhận/từ chối (chấp nhận PHẢI đi cùng batch update groups)
        ( existing().inviteeUid == uid()
          && existing().status == 'pending'
          && changedKeys().hasOnly(['status', 'respondedAt'])
          && incoming().status in ['accepted', 'rejected'] )
        ||
        // Admin mời lại (reset về pending với hạn mới)
        ( isAdminOfGroup(existing().groupId)
          && changedKeys().hasOnly(['status', 'expiresAt', 'createdAt', 'groupName', 'invitedBy'])
          && incoming().invitedBy == uid()
          && incoming().status == 'pending'
          && incoming().expiresAt > request.time
          && incoming().expiresAt <= request.time + duration.value(7, 'd') )
      );

      allow delete: if signedIn()
        && (existing().inviteeUid == uid() || isAdminOfGroup(existing().groupId));
    }

    // ════════ CHI TIÊU NHÓM (Hỗ trợ cả /expenses và alias /group_expenses) ════════
    match /expenses/{expenseId} {
      allow read: if isMemberOf(existing().groupId);
      allow create: if isMemberOf(incoming().groupId)
        && incoming().createdBy == uid()
        && incoming().payerId in groupOf(incoming().groupId).memberIds
        && allInGroup(incoming().groupId, incoming().participantIds)
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isMemberOf(existing().groupId)
        && (existing().createdBy == uid() || isAdminOfGroup(existing().groupId))
        && !changedKeys().hasAny(['id', 'groupId', 'createdBy', 'createdAt'])
        && incoming().payerId in groupOf(existing().groupId).memberIds
        && allInGroup(existing().groupId, incoming().participantIds)
        && incoming().amount is number && incoming().amount > 0;
      allow delete: if isMemberOf(existing().groupId)
        && (existing().createdBy == uid() || isAdminOfGroup(existing().groupId));
    }

    match /group_expenses/{expenseId} {
      allow read: if isMemberOf(existing().groupId);
      allow create: if isMemberOf(incoming().groupId)
        && incoming().createdBy == uid()
        && incoming().payerId in groupOf(incoming().groupId).memberIds
        && allInGroup(incoming().groupId, incoming().participantIds)
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isMemberOf(existing().groupId)
        && (existing().createdBy == uid() || isAdminOfGroup(existing().groupId))
        && !changedKeys().hasAny(['id', 'groupId', 'createdBy', 'createdAt'])
        && incoming().payerId in groupOf(existing().groupId).memberIds
        && allInGroup(existing().groupId, incoming().participantIds)
        && incoming().amount is number && incoming().amount > 0;
      allow delete: if isMemberOf(existing().groupId)
        && (existing().createdBy == uid() || isAdminOfGroup(existing().groupId));
    }

    // ════════ CÔNG NỢ (Debtor không được tự ý sửa hoặc xóa nợ) ════════
    match /debts/{debtId} {
      allow read: if isMemberOf(existing().groupId)
        || (signedIn() && (existing().debtorId == uid() || existing().creditorId == uid()));
      allow create: if isMemberOf(incoming().groupId)
        && incoming().debtorId in groupOf(incoming().groupId).memberIds
        && incoming().creditorId in groupOf(incoming().groupId).memberIds
        && incoming().debtorId != incoming().creditorId
        && incoming().amount is number && incoming().amount >= 0;
      // CHỈ CHỦ NỢ (creditorId) HOẶC ADMIN MỚI ĐƯỢC CẬP NHẬT TRẠNG THÁI / SỐ TIỀN
      allow update: if isMemberOf(existing().groupId)
        && (existing().creditorId == uid() || isAdminOfGroup(existing().groupId))
        && changedKeys().hasOnly(['amount', 'status', 'updatedAt'])
        && incoming().debtorId == existing().debtorId
        && incoming().creditorId == existing().creditorId
        && incoming().groupId == existing().groupId
        && incoming().amount is number && incoming().amount >= 0
        && incoming().status in ['active', 'settled', 'partiallySettled'];
      // CHỈ CHỦ NỢ HOẶC ADMIN MỚI ĐƯỢC XÓA NỢ
      allow delete: if isMemberOf(existing().groupId)
        && (existing().creditorId == uid() || isAdminOfGroup(existing().groupId));
    }

    // ════════ QUYẾT TOÁN (Hỗ trợ cả /settlements và alias /group_settlements) ════════
    match /settlements/{settlementId} {
      allow read: if isMemberOf(existing().groupId)
        || (signedIn() && (existing().payerId == uid() || existing().payeeId == uid()));
      allow create: if isMemberOf(incoming().groupId)
        && incoming().payerId == uid()
        && incoming().payeeId in groupOf(incoming().groupId).memberIds
        && incoming().payeeId != uid()
        && incoming().status in ['pendingConfirmation', 'pending_confirmation']
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isMemberOf(existing().groupId)
        && (existing().status in ['pendingConfirmation', 'pending_confirmation'])
        && !changedKeys().hasAny(['id', 'groupId', 'payerId', 'payeeId', 'amount', 'createdAt'])
        && (
          ( existing().payeeId == uid()
            && changedKeys().hasOnly(['status', 'confirmedAt', 'notes', 'updatedAt'])
            && incoming().status in ['confirmed', 'rejected'] )
          ||
          ( existing().payerId == uid()
            && changedKeys().hasOnly(['proofPhotoUrl', 'notes', 'updatedAt']) )
        );
      allow delete: if signedIn()
        && (existing().status in ['pendingConfirmation', 'pending_confirmation'])
        && (existing().payerId == uid() || isAdminOfGroup(existing().groupId));
    }

    match /group_settlements/{settlementId} {
      allow read: if isMemberOf(existing().groupId)
        || (signedIn() && (existing().payerId == uid() || existing().payeeId == uid()));
      allow create: if isMemberOf(incoming().groupId)
        && incoming().payerId == uid()
        && incoming().payeeId in groupOf(incoming().groupId).memberIds
        && incoming().payeeId != uid()
        && incoming().status in ['pendingConfirmation', 'pending_confirmation']
        && incoming().amount is number && incoming().amount > 0;
      allow update: if isMemberOf(existing().groupId)
        && (existing().status in ['pendingConfirmation', 'pending_confirmation'])
        && !changedKeys().hasAny(['id', 'groupId', 'payerId', 'payeeId', 'amount', 'createdAt'])
        && (
          ( existing().payeeId == uid()
            && changedKeys().hasOnly(['status', 'confirmedAt', 'notes', 'updatedAt'])
            && incoming().status in ['confirmed', 'rejected'] )
          ||
          ( existing().payerId == uid()
            && changedKeys().hasOnly(['proofPhotoUrl', 'notes', 'updatedAt']) )
        );
      allow delete: if signedIn()
        && (existing().status in ['pendingConfirmation', 'pending_confirmation'])
        && (existing().payerId == uid() || isAdminOfGroup(existing().groupId));
    }

    // ════════ GIAO DỊCH QUỸ ════════
    match /fund_transactions/{txId} {
      allow read: if isMemberOf(existing().groupId);
      allow create: if isMemberOf(incoming().groupId)
        && incoming().userId == uid()
        && incoming().amount is number && incoming().amount > 0;
      allow update: if false;
      allow delete: if isMemberOf(existing().groupId)
        && (existing().userId == uid() || isAdminOfGroup(existing().groupId));
    }

    // ════════ THÔNG BÁO — ghi chéo có kiểm soát cho luồng nhóm ════════
    function groupInviteNotification() {
      let d = request.resource.data;
      return d.type == 'group_invite'
        && d.senderUid == uid() && d.uid is string && d.uid != uid()
        && isAdminOfGroup(d.groupId)
        && exists(invitePath(d.groupId, d.uid));
    }
    function groupResponseNotification() {
      let d = request.resource.data;
      return d.type == 'group_response'
        && d.senderUid == uid()
        && groupExists(d.groupId)
        && (groupOf(d.groupId).get('adminId', '') == d.uid || groupOf(d.groupId).get('ownerId', '') == d.uid)
        && exists(invitePath(d.groupId, uid()));
    }
    match /notifications/{notificationId} {
      allow read: if ownsExisting();
      allow create: if signedIn() && (
        incoming().uid == uid() || groupInviteNotification() || groupResponseNotification()
      );
      allow update: if ownsExisting()
        && !changedKeys().hasAny(['uid', 'senderUid', 'type', 'groupId']);
      allow delete: if deletesOwn();
    }

    // ════════ MẶC ĐỊNH: CHẶN ════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
